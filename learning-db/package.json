{
  "name": "learning-knowledge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute learning-knowledge --local --file schema.sql",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.1"
  }
}
